{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the lab, layer, and mockup windows",
  "windows": ["lab", "bg-*", "w-*", "ch", "mockup"],
  "permissions": [
    "core:default",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-start-dragging",
    "core:event:default"
  ]
}
